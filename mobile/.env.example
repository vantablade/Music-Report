# Public config exposed to the app at build/runtime via Expo (EXPO_PUBLIC_ prefix).
# Copy to .env and fill in. Never put service-role / secret keys here.

# Backend API base URL (the FastAPI gateway).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Dev-only: set true to skip the Supabase sign-in gate and run with no backend.
EXPO_PUBLIC_DEV_NO_AUTH=false

# Supabase project (anon key is safe to ship in a client).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
