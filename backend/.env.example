# OMR backend config. Copy to .env if you need to override defaults.

# Path/command for the homr CLI. Default "homr" (on PATH, as in Docker).
# For local dev against the omr-eval venv, point this at its homr.exe, e.g.:
# HOMR_BIN=C:\Users\...\sheet-music-trainer\omr-eval\.venv\Scripts\homr.exe
HOMR_BIN=homr
